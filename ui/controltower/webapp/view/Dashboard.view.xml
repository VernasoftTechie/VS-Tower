<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  controllerName="vstower.controltower.controller.Dashboard"
  height="100%"
  displayBlock="true">

  <!-- Design note (2026-09-05 redesign): every card in the grid below is
       plain SVG/CSS built by the controller into one HTML string
       (Dashboard.controller.js - _cardHtml/_donutHtml/_barHtml/_renderCards),
       rendered through this single sap.ui.core.HTML block, in place of
       per-card sap.f.Card + sap.viz.VizFrame controls. Reasons: (1) it's
       the exact layout the client reviewed and approved in the mockup -
       compact, uniform-size cards, numbers beside the chart, no tables on
       the dashboard; VizFrame's own chrome/legend/spacing can't be pulled
       that tight. (2) it unifies donut and by-owner-bar rendering under one
       simple, fully-controlled technique instead of two. Click-to-drill-down
       is handled by one delegated listener in the controller
       (onAfterRendering/_onGridClick), since the grid's DOM is replaced
       wholesale on every 5s refresh - see the comment there. -->

  <App id="app">
  <Page id="page" class="ctPage" title="{i18n>pageTitle}" showHeader="true">
    <headerContent>
      <HBox alignItems="Center" visible="{/meta/autoRefresh}" class="ctLiveWrap sapUiTinyMarginEnd">
        <core:Icon src="sap-icon://record" class="ctLiveDot" color="Positive"/>
        <Text text="{i18n>live}" class="ctLiveText sapUiTinyMarginBegin"/>
      </HBox>
      <Text text="{i18n>lastUpdated}" class="sapUiTinyMarginEnd"/>
      <Text text="{/meta/lastUpdatedText}" class="ctLastUpdated sapUiSmallMarginEnd"/>
      <Switch state="{/meta/autoRefresh}" customTextOn="{i18n>autoOn}" customTextOff="{i18n>autoOff}"
              change=".onToggleAutoRefresh" tooltip="{i18n>autoRefreshTooltip}" class="sapUiTinyMarginEnd"/>
      <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh"/>
    </headerContent>

    <content>
      <MessageStrip
        id="errStrip"
        visible="false"
        type="Warning"
        showIcon="true"
        class="sapUiSmallMarginBottom"/>

      <Text text="{i18n>subTitle}" class="sapUiTinyMarginBottom"/>

      <core:HTML content="{/cardsHtml}" sanitizeContent="false"/>
    </content>
  </Page>
  </App>
</mvc:View>
