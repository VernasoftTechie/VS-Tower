<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  controllerName="vstower.controltower.controller.Dashboard"
  height="100%"
  displayBlock="true">

  <!-- Design note: every card is plain SVG/CSS built by the controller
       (_cardHtml/_donutHtml/_barHtml/_renderAll) and rendered through one
       sap.ui.core.HTML block per section. Click-to-drill-down is one
       delegated listener on the view root (onAfterRendering/_onGridClick),
       since each block's DOM is regenerated wholesale on refresh.

       Three sections (2026-09-07):
        - Live: current-state cards, auto-refreshes every 5s.
        - Workflow: analytical, refreshes on demand only (date-range
          filtering wired in a later stage).
        - Workforce Context: reference data, loads once. -->

  <App id="app">
  <Page id="page" class="ctPage" title="{i18n>pageTitle}" showHeader="true">
    <headerContent>
      <HBox alignItems="Center" visible="{/meta/autoRefresh}" class="ctLiveWrap sapUiTinyMarginEnd">
        <core:Icon src="sap-icon://record" class="ctLiveDot" color="Positive"/>
        <Text text="{i18n>live}" class="ctLiveText sapUiTinyMarginBegin"/>
      </HBox>
      <Switch state="{/meta/autoRefresh}" customTextOn="{i18n>autoOn}" customTextOff="{i18n>autoOff}"
              change=".onToggleAutoRefresh" tooltip="{i18n>autoRefreshTooltip}" class="sapUiTinyMarginEnd"/>
      <Button icon="sap-icon://refresh" tooltip="{i18n>refreshAll}" press=".onRefresh"/>
      <Button icon="sap-icon://sys-help" tooltip="{i18n>help}" press=".onHelp"/>
    </headerContent>

    <content>
      <MessageStrip
        id="errStrip"
        visible="false"
        type="Warning"
        showIcon="true"
        class="sapUiSmallMarginBottom"/>

      <Text text="{i18n>subTitle}" class="sapUiTinyMarginBottom"/>

      <!-- Live section -->
      <Toolbar design="Transparent" class="ctSectionBar sapUiSmallMarginTop">
        <Title text="{i18n>sectionLive}" level="H3"/>
        <Text text="{i18n>sectionLiveHint}" class="ctSectionHint sapUiSmallMarginBegin"/>
        <ToolbarSpacer/>
        <Text text="{i18n>lastUpdated}" class="ctSectionStamp"/>
        <Text text="{/meta/liveUpdatedText}" class="ctSectionStamp sapUiTinyMarginBegin"/>
      </Toolbar>
      <core:HTML content="{/liveHtml}" sanitizeContent="false"/>

      <!-- Workflow section -->
      <Toolbar design="Transparent" class="ctSectionBar sapUiMediumMarginTop">
        <Title text="{i18n>sectionWorkflow}" level="H3"/>
        <Text text="{i18n>sectionWorkflowHint}" class="ctSectionHint sapUiSmallMarginBegin"/>
        <ToolbarSpacer/>
        <Text text="{i18n>lastUpdated}" class="ctSectionStamp"/>
        <Text text="{/meta/workflowUpdatedText}" class="ctSectionStamp sapUiTinyMarginBegin sapUiTinyMarginEnd"/>
        <Button icon="sap-icon://refresh" tooltip="{i18n>refreshWorkflow}" press=".onRefreshWorkflow"/>
      </Toolbar>
      <core:HTML content="{/workflowHtml}" sanitizeContent="false"/>

      <!-- Workforce context section -->
      <Toolbar design="Transparent" class="ctSectionBar sapUiMediumMarginTop">
        <Title text="{i18n>sectionWorkforce}" level="H3"/>
        <Text text="{i18n>sectionWorkforceHint}" class="ctSectionHint sapUiSmallMarginBegin"/>
      </Toolbar>
      <core:HTML content="{/workforceHtml}" sanitizeContent="false"/>
    </content>
  </Page>
  </App>
</mvc:View>
